# Copy this file to .env and fill in the credentials from your PostgreSQL provider.
# With DB_NAME unset, the application continues to use the local SQLite database.
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your-postgresql-host
DB_PORT=5432

# Set this to require TLS when your provider requires it (commonly: require).
# DB_SSLMODE=require
